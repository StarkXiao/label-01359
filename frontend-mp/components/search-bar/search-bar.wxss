/* components/search-bar/search-bar.wxss */

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
}

.back-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
  margin-top: -14rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-search {
  font-size: 32rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
}

.search-placeholder-text {
  flex: 1;
  color: #BBBBBB;
  font-size: 28rpx;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #DDDDDD;
  border-radius: 50%;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}
