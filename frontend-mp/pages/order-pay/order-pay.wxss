/* pages/order-pay/order-pay.wxss */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 金额区域 */
.amount-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.amount-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.amount-value {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

.amount-price {
  font-size: 72rpx;
  color: #E91E63;
  font-weight: 600;
}

.countdown-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999999;
}

.countdown-time {
  color: #FF5252;
  font-weight: 600;
}

/* 支付方式 */
.method-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.method-list {
  display: flex;
  flex-direction: column;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.method-item:last-child {
  border-bottom: none;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.method-icon {
  font-size: 40rpx;
}

.method-name {
  font-size: 30rpx;
  color: #333333;
}

.method-radio {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #DDDDDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.method-radio.selected {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-color: #E91E63;
}

.radio-check {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

/* 订单信息 */
.order-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  border-radius: 16rpx;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.pay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 44rpx;
}

.pay-btn text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
