<!--pages/order-pay/order-pay.wxml - 支付页面-->
<view class="page-container">
  <!-- 订单金额 -->
  <view class="amount-section">
    <text class="amount-label">支付金额</text>
    <view class="amount-value">
      <text class="amount-symbol">¥</text>
      <text class="amount-price">{{order.payAmount}}</text>
    </view>
    <view class="countdown-tip">
      <text>请在 </text>
      <text class="countdown-time">{{countdownText}}</text>
      <text> 内完成支付</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="method-section">
    <view class="section-title">选择支付方式</view>
    <view class="method-list">
      <view 
        wx:for="{{payMethods}}" 
        wx:key="id" 
        class="method-item"
        bindtap="onSelectMethod"
        data-id="{{item.id}}"
      >
        <view class="method-left">
          <text class="method-icon">{{item.icon}}</text>
          <text class="method-name">{{item.name}}</text>
        </view>
        <view class="method-radio {{item.selected ? 'selected' : ''}}">
          <text wx:if="{{item.selected}}" class="radio-check">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-section">
    <view class="section-title">订单信息</view>
    <view class="order-info">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{order.id}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">商品数量</text>
        <text class="info-value">{{order.items.length}}件</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar safe-area-bottom">
    <view class="pay-btn" bindtap="onConfirmPay">
      <text>确认支付 ¥{{order.payAmount}}</text>
    </view>
  </view>
</view>
