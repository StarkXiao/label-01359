/* pages/order-detail/order-detail.wxss */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 状态区域 */
.status-section {
  padding: 48rpx 32rpx;
  background: #ffffff;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
}

.status-section.completed {
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
}

.status-section.cancelled {
  background: linear-gradient(135deg, #9E9E9E 0%, #BDBDBD 100%);
}

.status-text {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 28rpx;
}

/* 地址区域 */
.address-section {
  display: flex;
  padding: 32rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.address-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.address-info {
  flex: 1;
}

.address-user {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.user-phone {
  font-size: 28rpx;
  color: #666666;
}

.address-detail {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

/* 商品区域 */
.goods-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goods-item {
  display: flex;
  gap: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.goods-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 28rpx;
  color: #E91E63;
  font-weight: 500;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999999;
}

/* 订单信息 */
.info-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

/* 价格区域 */
.price-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  border-radius: 16rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-row.total {
  padding-top: 24rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #F5F5F5;
}

.price-label {
  font-size: 28rpx;
  color: #666666;
}

.price-value {
  font-size: 28rpx;
  color: #333333;
}

.price-value.highlight {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  border: 2rpx solid #DDDDDD;
}

.action-btn text {
  font-size: 28rpx;
  color: #666666;
}

.action-btn.primary {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border: none;
}

.action-btn.primary text {
  color: #FFFFFF;
}

.action-btn.cancel {
  border-color: #FF5252;
}

.action-btn.cancel text {
  color: #FF5252;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
