<!--pages/order-detail/order-detail.wxml - 订单详情页-->
<view class="page-container" wx:if="{{order}}">
  <!-- 订单状态 -->
  <view class="status-section {{order.status}}">
    <text class="status-text">{{order.statusText}}</text>
    <text class="status-desc">{{statusDesc}}</text>
  </view>

  <!-- 收货地址 -->
  <view class="address-section">
    <view class="address-icon">📍</view>
    <view class="address-info">
      <view class="address-user">
        <text class="user-name">{{order.address.name}}</text>
        <text class="user-phone">{{order.address.phone}}</text>
      </view>
      <text class="address-detail">{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-section">
    <view class="section-title">商品信息</view>
    <view class="goods-list">
      <view wx:for="{{order.items}}" wx:key="id" class="goods-item" bindtap="onGoodsTap" data-item="{{item}}">
        <image class="goods-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-subtitle">{{item.subtitle}}</text>
          <view class="goods-bottom">
            <text class="goods-price">¥{{item.price}}</text>
            <text class="goods-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-section">
    <view class="section-title">订单信息</view>
    <view class="info-list">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{order.id}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{createTimeText}}</text>
      </view>
      <view wx:if="{{order.payTime}}" class="info-row">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{payTimeText}}</text>
      </view>
      <view wx:if="{{order.remark}}" class="info-row">
        <text class="info-label">订单备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-row">
      <text class="price-label">商品金额</text>
      <text class="price-value">¥{{order.totalPrice}}</text>
    </view>
    <view class="price-row">
      <text class="price-label">运费</text>
      <text class="price-value">{{order.freight > 0 ? '¥' + order.freight : '免运费'}}</text>
    </view>
    <view class="price-row total">
      <text class="price-label">实付金额</text>
      <text class="price-value highlight">¥{{order.payAmount}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view wx:if="{{order.status === 'unpaid' || order.status === 'unreceived'}}" class="action-bar safe-area-bottom">
    <view wx:if="{{order.status === 'unpaid'}}" class="action-btn cancel" bindtap="onCancelOrder">
      <text>取消订单</text>
    </view>
    <view wx:if="{{order.status === 'unpaid'}}" class="action-btn primary" bindtap="onPayOrder">
      <text>去支付</text>
    </view>
    <view wx:if="{{order.status === 'unreceived'}}" class="action-btn primary" bindtap="onConfirmReceive">
      <text>确认收货</text>
    </view>
  </view>
</view>
