/* pages/category/category.wxss - 分类页样式 */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-wrapper {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
}

/* 分类内容 */
.category-content {
  flex: 1;
  display: flex;
  height: calc(100vh - 180rpx);
}

/* 左侧一级分类 */
.category-left {
  width: 200rpx;
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.category-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  transition: all 0.2s ease;
}

.category-item.active {
  background-color: #FFF8F9;
}

.category-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #E91E63 0%, #FF4081 100%);
  border-radius: 0 3rpx 3rpx 0;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.category-item.active .category-name {
  color: #E91E63;
  font-weight: 500;
}

/* 右侧二级分类 */
.category-right {
  flex: 1;
  background-color: #FFF8F9;
  padding: 24rpx;
}

.sub-category-header {
  margin-bottom: 24rpx;
}

.sub-category-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.sub-category-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 二级分类网格 */
.sub-category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.sub-category-item {
  width: calc(33.33% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.sub-category-item:active {
  transform: scale(0.95);
}

.sub-category-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFF0F5 0%, #FCE4EC 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.sub-category-icon {
  width: 48rpx;
  height: 48rpx;
}

.sub-category-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}

/* 推荐区域 */
.recommend-section {
  margin-top: 16rpx;
}

.recommend-header {
  margin-bottom: 16rpx;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.recommend-banner {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.recommend-image {
  width: 100%;
  height: 100%;
}

.recommend-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(233, 30, 99, 0.8) 0%, rgba(255, 64, 129, 0.6) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.recommend-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.recommend-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  padding: 8rpx 32rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 32rpx;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 248, 249, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #FCE4EC;
  border-top-color: #E91E63;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #E91E63;
}
