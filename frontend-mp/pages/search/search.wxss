/* pages/search/search.wxss - 搜索页样式 */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 搜索头部 */
.search-header {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
}

.search-wrapper {
  padding: 16rpx 24rpx;
}

/* 搜索内容 */
.search-content {
  flex: 1;
  padding: 24rpx;
}

/* 区块样式 */
.history-section,
.hot-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999999;
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 24rpx;
}

.clear-icon {
  font-size: 24rpx;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 16rpx 28rpx;
  background-color: #F5F5F5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.2s ease;
}

.tag-item:active {
  transform: scale(0.95);
  background-color: #FCE4EC;
}

.tag-item.hot {
  background: linear-gradient(135deg, #FFF0F5 0%, #FCE4EC 100%);
  color: #E91E63;
  border: 1rpx solid #FCE4EC;
}

/* 搜索结果 */
.result-section {
  padding-bottom: 32rpx;
}

.result-header {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #666666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.result-item {
  width: calc(50% - 10rpx);
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.result-item:active {
  transform: scale(0.98);
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 8rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-original {
  font-size: 22rpx;
  color: #CCCCCC;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #FCE4EC;
  border-top-color: #E91E63;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-state text {
  font-size: 28rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
}
