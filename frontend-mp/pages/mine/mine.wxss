/* pages/mine/mine.wxss - 我的页面样式 */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 未登录状态容器 */
.not-login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5F5;
}

/* 空状态 - 与购物车样式完全一致 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 80rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

/* 用户信息区域 */
.user-section {
  position: relative;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 50%, #FF6B9D 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.user-content {
  position: relative;
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.vip-badge {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  white-space: nowrap;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.phone {
  display: block;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.arrow-icon {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 会员卡片 */
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(233, 30, 99, 0.15);
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.member-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #E91E63;
}

.member-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.member-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EEEEEE;
}

/* 订单区域 */
.order-section {
  margin: 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #999999;
  margin-right: 48rpx;
}

.section-more .arrow {
  font-size: 36rpx;
  margin-bottom: 2rpx;
}

.order-menu {
  display: flex;
  justify-content: space-between;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 16rpx 0;
}

.order-icon-wrapper {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFF8F9;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.order-icon {
  font-size: 36rpx;
}

.order-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background-color: #FF5252;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-name {
  font-size: 26rpx;
  color: #666666;
  text-align: center;
}

/* 服务区域 */
.service-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.service-list {
  margin-top: 8rpx;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-icon {
  font-size: 36rpx;
}

.service-name {
  font-size: 28rpx;
  color: #333333;
}

.service-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.service-badge {
  font-size: 24rpx;
  color: #E91E63;
}

.service-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 退出登录 */
.logout-section {
  margin: 48rpx 24rpx;
}

.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: #FFFFFF;
  border-radius: 44rpx;
  border: 2rpx solid #E91E63;
}

.logout-btn text {
  font-size: 30rpx;
  color: #E91E63;
  line-height: 1;
}

/* 底部安全区域 */
.bottom-safe-area {
  height: 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
