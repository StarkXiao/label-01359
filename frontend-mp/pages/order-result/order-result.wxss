/* pages/order-result/order-result.wxss */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
}

/* 结果区域 */
.result-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.result-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.result-icon.success {
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
}

.result-icon.fail {
  background: linear-gradient(135deg, #FF5252 0%, #FF8A80 100%);
}

.result-icon text {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.result-amount {
  font-size: 48rpx;
  font-weight: 600;
  color: #E91E63;
}

/* 信息区域 */
.info-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

/* 操作按钮 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E91E63;
}

.action-btn text {
  font-size: 30rpx;
  color: #E91E63;
  line-height: 1;
}

.action-btn.primary {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border: none;
}

.action-btn.primary text {
  color: #FFFFFF;
}
