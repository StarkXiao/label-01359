/* pages/cart/cart.wxss - 购物车页样式 */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* 顶部操作栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.header-title {
  font-size: 28rpx;
  color: #666666;
}

.header-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 28rpx;
  color: #E91E63;
}

/* 购物车列表 */
.cart-list {
  flex: 1;
  padding: 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 选择框 */
.checkbox-wrapper {
  padding: 16rpx;
  margin-left: -16rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #DDDDDD;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.checkbox.checked {
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-color: #E91E63;
}

.check-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 商品图片 */
.product-image-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.product-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.quantity-btn {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666666;
  transition: background-color 0.2s ease;
  box-sizing: border-box;
}

.quantity-btn text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
}

.quantity-btn:active {
  background-color: #EEEEEE;
}

.quantity-btn.decrease {
  color: #999999;
}

.quantity-btn.increase {
  color: #E91E63;
}

.quantity-value {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333333;
}

/* 删除按钮 */
.delete-btn {
  width: 56rpx;
  height: 56rpx;
  background-color: #FF5252;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 120rpx;
  margin-top: 120rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 80rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  margin-left: -16rpx;
}

.select-all-text {
  font-size: 28rpx;
  color: #333333;
}

.checkout-info {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-right: 24rpx;
}

.total-wrapper {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
}

.total-symbol {
  font-size: 26rpx;
  color: #E91E63;
  font-weight: 600;
}

.total-price {
  font-size: 40rpx;
  color: #E91E63;
  font-weight: 600;
}

.checkout-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(233, 30, 99, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkout-btn text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.checkout-btn.disabled {
  background: #CCCCCC;
  box-shadow: none;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
