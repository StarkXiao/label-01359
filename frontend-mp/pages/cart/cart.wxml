<!--pages/cart/cart.wxml - 购物车页-->
<view class="page-container">
  <!-- 未登录状态 -->
  <view wx:if="{{!isLogin}}" class="empty-state">
    <view class="empty-icon">🔐</view>
    <text class="empty-title">请先登录</text>
    <text class="empty-desc">登录后可使用购物车功能</text>
    <view class="empty-btn" bindtap="onGoLogin">
      <text>去登录</text>
    </view>
  </view>

  <!-- 已登录状态 -->
  <block wx:if="{{isLogin}}">
    <!-- 顶部操作栏 -->
    <view class="header-bar" wx:if="{{!isEmpty}}">
      <text class="header-title">共{{cartList.length}}件商品</text>
      <view class="header-actions">
        <text class="action-btn" bindtap="onToggleEdit">{{isEditing ? '完成' : '编辑'}}</text>
      </view>
    </view>

    <!-- 购物车列表 -->
    <scroll-view 
      wx:if="{{!isEmpty}}"
      class="cart-list" 
      scroll-y 
      enhanced 
      show-scrollbar="{{false}}"
    >
      <view 
        wx:for="{{cartList}}" 
        wx:key="id"
        class="cart-item"
      >
        <!-- 选择框 -->
        <view class="checkbox-wrapper" bindtap="onSelectItem" data-index="{{index}}">
          <view class="checkbox {{item.selected ? 'checked' : ''}}">
            <text wx:if="{{item.selected}}" class="check-icon">✓</text>
          </view>
        </view>

        <!-- 商品图片 -->
        <view class="product-image-wrapper" bindtap="onProductTap" data-item="{{item}}">
          <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" />
        </view>

        <!-- 商品信息 -->
        <view class="product-info" bindtap="onProductTap" data-item="{{item}}">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="product-price">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.price}}</text>
            </view>
            
            <!-- 数量控制 -->
            <view class="quantity-control">
              <view class="quantity-btn decrease" catchtap="onDecrease" data-index="{{index}}">
                <text>-</text>
              </view>
              <text class="quantity-value">{{item.quantity}}</text>
              <view class="quantity-btn increase" catchtap="onIncrease" data-index="{{index}}">
                <text>+</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 删除按钮（编辑模式） -->
        <view 
          wx:if="{{isEditing}}" 
          class="delete-btn" 
          catchtap="onDeleteItem" 
          data-index="{{index}}"
        >
          <text class="delete-icon">×</text>
        </view>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-placeholder"></view>
    </scroll-view>

    <!-- 空状态 -->
    <view wx:if="{{isEmpty}}" class="empty-state">
      <view class="empty-icon">🛒</view>
      <text class="empty-title">购物车空空如也</text>
      <text class="empty-desc">快去挑选心仪的鲜花吧</text>
      <view class="empty-btn" bindtap="onGoShopping">
        <text>去逛逛</text>
      </view>
    </view>

    <!-- 底部结算栏 -->
    <view wx:if="{{!isEmpty}}" class="checkout-bar safe-area-bottom">
      <view class="select-all" bindtap="onSelectAll">
        <view class="checkbox {{isAllSelected ? 'checked' : ''}}">
          <text wx:if="{{isAllSelected}}" class="check-icon">✓</text>
        </view>
        <text class="select-all-text">全选</text>
      </view>

      <view class="checkout-info">
        <view class="total-wrapper">
          <text class="total-label">合计：</text>
          <text class="total-symbol">¥</text>
          <text class="total-price">{{totalPrice}}</text>
        </view>
      </view>

      <view 
        class="checkout-btn {{totalCount > 0 ? '' : 'disabled'}}" 
        bindtap="{{isEditing ? 'onDeleteSelected' : 'onCheckout'}}"
      >
        <text wx:if="{{isEditing}}">删除({{totalCount}})</text>
        <text wx:else>结算({{totalCount}})</text>
      </view>
    </view>
  </block>
</view>
