/* pages/product-list/product-list.wxss - 商品列表页样式 */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 排序栏 */
.sort-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.sort-item {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  font-size: 28rpx;
  color: #666666;
  transition: color 0.2s ease;
}

.sort-item.active {
  color: #E91E63;
  font-weight: 500;
}

.sort-arrow {
  display: flex;
  flex-direction: column;
  margin-left: 4rpx;
  line-height: 1;
}

.arrow-up, .arrow-down {
  font-size: 16rpx;
  color: #CCCCCC;
  height: 16rpx;
  line-height: 16rpx;
}

.arrow-up.active, .arrow-down.active {
  color: #E91E63;
}

/* 商品列表 */
.product-list {
  flex: 1;
  padding: 24rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.product-item {
  width: calc(50% - 10rpx);
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 8rpx;
}

.product-info {
  position: relative;
  padding: 16rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-value {
  font-size: 36rpx;
  color: #E91E63;
  font-weight: 600;
}

.price-original {
  font-size: 22rpx;
  color: #CCCCCC;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999999;
}

.add-cart-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.3);
}

.add-cart-btn text {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
}

/* 列表底部 */
.list-footer {
  padding: 40rpx 0;
  text-align: center;
}

.list-footer text {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 加载状态 */
.loading-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #FCE4EC;
  border-top-color: #E91E63;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-state text {
  font-size: 28rpx;
  color: #999999;
}

/* 错误状态 */
.error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 32rpx;
}

.retry-btn text {
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
}
