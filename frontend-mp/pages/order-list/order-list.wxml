<!--pages/order-list/order-list.wxml - 订单列表页-->
<view class="page-container">
  <!-- 标签栏 -->
  <view class="tabs-bar">
    <view 
      wx:for="{{tabs}}" 
      wx:key="id" 
      class="tab-item {{currentTab === item.id ? 'active' : ''}}"
      bindtap="onTabChange"
      data-id="{{item.id}}"
    >
      <text>{{item.name}}</text>
      <view wx:if="{{item.count > 0}}" class="tab-badge">{{item.count}}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view 
    wx:if="{{orderList.length > 0}}"
    class="order-list" 
    scroll-y 
    enhanced 
    show-scrollbar="{{false}}"
  >
    <view wx:for="{{orderList}}" wx:key="id" class="order-card">
      <!-- 订单头部 -->
      <view class="order-header" bindtap="onOrderTap" data-order="{{item}}">
        <text class="order-id">订单号：{{item.id}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="order-goods" bindtap="onOrderTap" data-order="{{item}}">
        <view wx:for="{{item.items}}" wx:for-item="goods" wx:key="id" class="goods-item">
          <image class="goods-image" src="{{goods.imageUrl}}" mode="aspectFill" />
          <view class="goods-info">
            <text class="goods-name">{{goods.name}}</text>
            <view class="goods-bottom">
              <text class="goods-price">¥{{goods.price}}</text>
              <text class="goods-quantity">x{{goods.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-total">
          <text>共{{item.items.length}}件商品，合计：</text>
          <text class="total-price">¥{{item.payAmount}}</text>
        </view>
        <view class="order-actions">
          <view 
            wx:if="{{item.status === 'unpaid'}}" 
            class="action-btn cancel"
            catchtap="onCancelOrder"
            data-order="{{item}}"
          >
            <text>取消订单</text>
          </view>
          <view 
            wx:if="{{item.status === 'unpaid'}}" 
            class="action-btn primary"
            catchtap="onPayOrder"
            data-order="{{item}}"
          >
            <text>去支付</text>
          </view>
          <view 
            wx:if="{{item.status === 'unreceived'}}" 
            class="action-btn primary"
            catchtap="onConfirmReceive"
            data-order="{{item}}"
          >
            <text>确认收货</text>
          </view>
          <view 
            wx:if="{{item.status === 'completed'}}" 
            class="action-btn"
            catchtap="onBuyAgain"
            data-order="{{item}}"
          >
            <text>再次购买</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 空状态 -->
  <view wx:if="{{orderList.length === 0}}" class="empty-state">
    <view class="empty-icon">📋</view>
    <text class="empty-title">暂无订单</text>
    <text class="empty-desc">快去挑选心仪的鲜花吧</text>
    <view class="empty-btn" bindtap="onGoShopping">
      <text>去逛逛</text>
    </view>
  </view>
</view>
