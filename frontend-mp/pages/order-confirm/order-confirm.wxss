/* pages/order-confirm/order-confirm.wxss */

.page-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

/* 地址区域 */
.address-section {
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.address-content {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.address-info {
  flex: 1;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.user-phone {
  font-size: 28rpx;
  color: #666666;
}

.address-detail {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.address-arrow {
  font-size: 40rpx;
  color: #CCCCCC;
}

.address-empty {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.empty-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.empty-text {
  flex: 1;
  font-size: 28rpx;
  color: #999999;
}

.address-line {
  height: 8rpx;
  background: repeating-linear-gradient(
    90deg,
    #E91E63 0,
    #E91E63 20rpx,
    #FF9800 20rpx,
    #FF9800 40rpx,
    #4CAF50 40rpx,
    #4CAF50 60rpx
  );
}

/* 商品区域 */
.goods-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.goods-item {
  display: flex;
  gap: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.goods-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.goods-price .price-symbol {
  font-size: 24rpx;
  color: #E91E63;
}

.goods-price .price-value {
  font-size: 32rpx;
  color: #E91E63;
  font-weight: 600;
}

.goods-quantity {
  font-size: 26rpx;
  color: #999999;
}

/* 备注区域 */
.remark-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #FFFFFF;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.remark-label {
  font-size: 28rpx;
  color: #333333;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.remark-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 价格区域 */
.price-section {
  background-color: #FFFFFF;
  padding: 32rpx;
  border-radius: 16rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.price-label {
  font-size: 28rpx;
  color: #666666;
}

.price-row .price-value {
  font-size: 28rpx;
  color: #333333;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666666;
}

.total-symbol {
  font-size: 26rpx;
  color: #E91E63;
  font-weight: 600;
}

.total-price {
  font-size: 40rpx;
  color: #E91E63;
  font-weight: 600;
}

.submit-btn {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #E91E63 0%, #FF4081 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
