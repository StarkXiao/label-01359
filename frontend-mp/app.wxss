/* app.wxss - 全局样式 */

/* 引入样式变量 */
@import './styles/variables.wxss';

/* 重置样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333333;
  background-color: #FFF8F9;
  box-sizing: border-box;
}

/* 盒模型 */
view, text, image, navigator, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* 清除按钮默认样式 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  border-radius: 0;
  line-height: inherit;
}

button::after {
  border: none;
}

/* Flex 布局工具类 */
.flex {
  display: flex;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

.justify-end {
  justify-content: flex-end;
}

/* 文本工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 间距工具类 */
.m-0 { margin: 0; }
.m-8 { margin: 16rpx; }
.m-16 { margin: 32rpx; }
.m-24 { margin: 48rpx; }

.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }

.mb-8 { margin-bottom: 16rpx; }
.mb-16 { margin-bottom: 32rpx; }
.mb-24 { margin-bottom: 48rpx; }

.ml-8 { margin-left: 16rpx; }
.ml-16 { margin-left: 32rpx; }

.mr-8 { margin-right: 16rpx; }
.mr-16 { margin-right: 32rpx; }

.p-0 { padding: 0; }
.p-8 { padding: 16rpx; }
.p-16 { padding: 32rpx; }
.p-24 { padding: 48rpx; }

.pt-8 { padding-top: 16rpx; }
.pt-16 { padding-top: 32rpx; }

.pb-8 { padding-bottom: 16rpx; }
.pb-16 { padding-bottom: 32rpx; }

.pl-8 { padding-left: 16rpx; }
.pl-16 { padding-left: 32rpx; }

.pr-8 { padding-right: 16rpx; }
.pr-16 { padding-right: 32rpx; }

/* 颜色工具类 */
.text-primary {
  color: #E91E63;
}

.text-secondary {
  color: #FF4081;
}

.text-gray {
  color: #999999;
}

.text-dark {
  color: #333333;
}

.text-white {
  color: #FFFFFF;
}

.bg-primary {
  background-color: #E91E63;
}

.bg-white {
  background-color: #FFFFFF;
}

.bg-light {
  background-color: #FFF8F9;
}

/* 圆角工具类 */
.rounded-sm {
  border-radius: 8rpx;
}

.rounded {
  border-radius: 16rpx;
}

.rounded-lg {
  border-radius: 24rpx;
}

.rounded-full {
  border-radius: 50%;
}

/* 阴影工具类 */
.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.shadow-lg {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* 宽度工具类 */
.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

/* 价格样式 */
.price {
  color: #E91E63;
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
}

.price-integer {
  font-size: 36rpx;
}

.price-decimal {
  font-size: 24rpx;
}

.price-original {
  color: #999999;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.tag-primary {
  background-color: rgba(233, 30, 99, 0.1);
  color: #E91E63;
}

.tag-hot {
  background-color: #FF5722;
  color: #FFFFFF;
}

.tag-new {
  background-color: #4CAF50;
  color: #FFFFFF;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #EEEEEE;
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-state-text {
  color: #999999;
  font-size: 28rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.loading-text {
  color: #999999;
  font-size: 26rpx;
  margin-left: 16rpx;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
